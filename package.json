{
  "name": "paletteswap",
  "version": "1.0.8",
  "private": true,
  "description": "PaletteSwap Minecraft texture editor for Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "jp.minekoubou.texturestudio",
    "productName": "PaletteSwap",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "sirotumekuma",
        "repo": "PaletteSwap",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "favicon.ico",
      "マイクラ テクスチャ工房.html",
      "textures/**/*.png",
      "package.json"
    ],
    "win": {
      "icon": "favicon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaletteSwap",
      "uninstallDisplayName": "PaletteSwap",
      "language": "1041",
      "installerLanguages": "ja_JP"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
